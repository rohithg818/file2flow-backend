# ============================================
# File2Flow — Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values.

# Firebase (Auth only — used client-side for authentication)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase (Client-side — anon key is safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase (Server-side — NEVER expose to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI Services (Server-side ONLY — NEVER use VITE_ prefix)
GROQ_API_KEY=

# Gotenberg (document conversion service)
GOTENBERG_URL=

# Backend URLs
VITE_ENGINE_URL=http://localhost:5000
VITE_API_URL=http://localhost:3001
ENGINE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Stripe (legacy — being replaced by Paddle)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_YEARLY=

# Paddle (Sandbox — primary billing provider)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
PADDLE_VENDOR_ID=
PADDLE_PRICE_ID_STARTER_MONTHLY=
PADDLE_PRICE_ID_STARTER_YEARLY=
PADDLE_PRICE_ID_BUSINESS_MONTHLY=
PADDLE_PRICE_ID_BUSINESS_YEARLY=

# Backend Server
PORT=3001

# Logging
LOG_LEVEL=info
NODE_ENV=development
