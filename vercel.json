{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!api/|_next/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    }
  ],
  "functions": {
    "api/ai.mjs": {
      "maxDuration": 60
    },
    "api/ocr.mjs": {
      "maxDuration": 120
    },
    "api/translate.mjs": {
      "maxDuration": 60
    },
    "api/json-to-pdf.mjs": {
      "maxDuration": 120
    }
  }
}
